# BalanceVault Environment Configuration (Demonstration - Synthetic Data Only)

NODE_ENV=development
PORT=5000

# PostgreSQL Database URL (Neon or Local Postgres)
# Example for Neon: postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/balancevault?schema=public"

# Redis Cache & Rate Limiting (Optional - Falls back to in-memory store if unreachable)
REDIS_URL="redis://localhost:6379"
REDIS_FAIL_CLOSED_ON_AUTH=true

# JWT Authentication
JWT_SECRET="balancevault-synthetic-jwt-secret-key-32chars"
JWT_EXPIRES_IN="8h"

# Bootstrap Security Secret (Used by the bootstrap operator or CLI)
BOOTSTRAP_TOKEN="bv_bootstrap_operator_key_super_secret"

# Frontend Origin for CORS
CORS_ORIGIN="http://localhost:5173"
